# ESP32 Hardware PUF Configuration
# For UAV-GCC Authentication System with True Hardware SRAM PUF
# Save this as: sdkconfig.defaults in your project root

#
# Compiler options
#
CONFIG_COMPILER_OPTIMIZATION_LEVEL_RELEASE=y
CONFIG_COMPILER_OPTIMIZATION_PERF=y
CONFIG_COMPILER_OPTIMIZATION_ASSERTIONS_ENABLE=y

#
# Bootloader config (Critical for Deep Sleep PUF)
#
CONFIG_BOOTLOADER_LOG_LEVEL_INFO=y
CONFIG_BOOTLOADER_SKIP_VALIDATE_IN_DEEP_SLEEP=y

#
# ESP32-specific Configuration
#
CONFIG_ESP32_DEFAULT_CPU_FREQ_240=y
CONFIG_ESP32_DEFAULT_CPU_FREQ_MHZ=240

# RTC Clock Configuration (Critical for Hardware PUF)
CONFIG_ESP32_RTC_CLK_SRC_INT_RC=y
CONFIG_ESP32_RTC_CLK_CAL_CYCLES=1024
CONFIG_ESP32_RTC_SLOW_CLK_STARTUP_MS=0

# RTC Memory Configuration (CRITICAL - DO NOT CHANGE)
CONFIG_ESP32_RTC_FAST_MEM_SIZE=8192
CONFIG_ESP32_ALLOW_RTC_FAST_MEM_AS_HEAP=n

# Deep Sleep Configuration (Critical for Method 2 PUF)
CONFIG_ESP32_DEEP_SLEEP_WAKEUP_DELAY=2000
CONFIG_ESP32_ENABLE_COREDUMP_TO_NONE=y

# Power Management
CONFIG_PM_ENABLE=n

#
# FreeRTOS Configuration
#
CONFIG_FREERTOS_HZ=1000
CONFIG_FREERTOS_IDLE_TASK_STACKSIZE=2048
CONFIG_FREERTOS_USE_TRACE_FACILITY=y
CONFIG_FREERTOS_GENERATE_RUN_TIME_STATS=n
CONFIG_FREERTOS_USE_STATS_FORMATTING_FUNCTIONS=n

# Task Watchdog (Increased timeout for PUF operations)
CONFIG_ESP_TASK_WDT=y
CONFIG_ESP_TASK_WDT_TIMEOUT_S=10
CONFIG_ESP_TASK_WDT_PANIC=y
CONFIG_ESP_TASK_WDT_CHECK_IDLE_TASK_CPU0=y
CONFIG_ESP_TASK_WDT_CHECK_IDLE_TASK_CPU1=y

# Main Task Stack Size (Increased for PUF enrollment)
CONFIG_ESP_MAIN_TASK_STACK_SIZE=16384

# Stack Overflow Protection
CONFIG_FREERTOS_CHECK_STACKOVERFLOW_CANARY=y
CONFIG_FREERTOS_WATCHPOINT_END_OF_STACK=n

#
# Heap Memory Configuration
#
CONFIG_HEAP_POISONING_DISABLED=y
CONFIG_HEAP_TRACING_OFF=y

#
# Logging Configuration
#
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
CONFIG_LOG_DEFAULT_LEVEL=3
CONFIG_LOG_MAXIMUM_LEVEL_VERBOSE=y
CONFIG_LOG_MAXIMUM_LEVEL=5
CONFIG_LOG_COLORS=y
CONFIG_LOG_TIMESTAMP_SOURCE_RTOS=y

#
# mbedTLS Hardware Acceleration (Critical for Performance)
#
CONFIG_MBEDTLS_HARDWARE_AES=y
CONFIG_MBEDTLS_AES_USE_INTERRUPT=n
CONFIG_MBEDTLS_HARDWARE_SHA=y
CONFIG_MBEDTLS_HARDWARE_MPI=y
CONFIG_MBEDTLS_MPI_USE_INTERRUPT=n
CONFIG_MBEDTLS_INTERNAL_MEM_ALLOC=y
CONFIG_MBEDTLS_DEFAULT_MEM_ALLOC=y
CONFIG_MBEDTLS_SSL_MAX_CONTENT_LEN=16384
CONFIG_MBEDTLS_ASYMMETRIC_CONTENT_LEN=n

# mbedTLS Features
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=n
CONFIG_MBEDTLS_ECP_DP_SECP192R1_ENABLED=y
CONFIG_MBEDTLS_ECP_DP_SECP224R1_ENABLED=y
CONFIG_MBEDTLS_ECP_DP_SECP256R1_ENABLED=y
CONFIG_MBEDTLS_ECP_DP_SECP384R1_ENABLED=y
CONFIG_MBEDTLS_ECP_DP_SECP521R1_ENABLED=y

#
# NVS Configuration (For PUF Enrollment Data Storage)
#
CONFIG_NVS_ENCRYPTION=n

#
# Partition Table
#
CONFIG_PARTITION_TABLE_SINGLE_APP=y
CONFIG_PARTITION_TABLE_TWO_OTA=n
CONFIG_PARTITION_TABLE_CUSTOM=n
CONFIG_PARTITION_TABLE_OFFSET=0x8000
CONFIG_PARTITION_TABLE_MD5=y

#
# Serial Flash Configuration
#
CONFIG_ESPTOOLPY_FLASHMODE_DIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_40M=y
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_ESPTOOLPY_FLASHSIZE=0x400000

#
# Wi-Fi Configuration (ESP-NOW Optimized)
#
CONFIG_ESP32_WIFI_STATIC_RX_BUFFER_NUM=16
CONFIG_ESP32_WIFI_DYNAMIC_RX_BUFFER_NUM=32
CONFIG_ESP32_WIFI_TX_BUFFER_TYPE=1
CONFIG_ESP32_WIFI_DYNAMIC_TX_BUFFER_NUM=32
CONFIG_ESP32_WIFI_AMPDU_TX_ENABLED=y
CONFIG_ESP32_WIFI_TX_BA_WIN=6
CONFIG_ESP32_WIFI_AMPDU_RX_ENABLED=y
CONFIG_ESP32_WIFI_RX_BA_WIN=6
CONFIG_ESP32_WIFI_NVS_ENABLED=y
CONFIG_ESP32_WIFI_SOFTAP_BEACON_MAX_LEN=752
CONFIG_ESP32_WIFI_MGMT_SBUF_NUM=32

# ESP-NOW Configuration
CONFIG_ESP_WIFI_ESPNOW_MAX_ENCRYPT_NUM=7

#
# PHY Configuration
#
CONFIG_ESP_PHY_CALIBRATION_AND_DATA_STORAGE=y
CONFIG_ESP_PHY_INIT_DATA_IN_PARTITION=n
CONFIG_ESP_PHY_MAX_WIFI_TX_POWER=20
CONFIG_ESP_PHY_MAX_TX_POWER=20

#
# Security Features
#
CONFIG_SECURE_BOOT=n
CONFIG_SECURE_BOOT_V2_ENABLED=n
CONFIG_SECURE_FLASH_ENC_ENABLED=n
CONFIG_SECURE_FLASH_ENCRYPTION_MODE_DEVELOPMENT=n
CONFIG_SECURE_DISABLE_ROM_DL_MODE=n

#
# System Configuration
#
CONFIG_ESP_SYSTEM_EVENT_QUEUE_SIZE=32
CONFIG_ESP_SYSTEM_EVENT_TASK_STACK_SIZE=4096
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
CONFIG_ESP_CONSOLE_UART_NUM=0
CONFIG_ESP_CONSOLE_UART_BAUDRATE=115200
CONFIG_ESP_INT_WDT=y
CONFIG_ESP_INT_WDT_TIMEOUT_MS=300
CONFIG_ESP_INT_WDT_CHECK_CPU1=y

# Memory Protection
CONFIG_ESP_SYSTEM_MEMPROT_FEATURE=y

#
# IPC (Inter-Processor Call)
#
CONFIG_ESP_IPC_TASK_STACK_SIZE=2048
CONFIG_ESP_IPC_USES_CALLERS_PRIORITY=y

#
# Common ESP-related
#
CONFIG_ESP_ERR_TO_NAME_LOOKUP=y

#
# Core Dump
#
CONFIG_ESP_COREDUMP_ENABLE_TO_NONE=y
CONFIG_ESP_COREDUMP_ENABLE=n

#
# FAT Filesystem
#
CONFIG_FATFS_CODEPAGE_437=y
CONFIG_FATFS_LFN_NONE=y

#
# Newlib
#
CONFIG_NEWLIB_STDOUT_LINE_ENDING_CRLF=y
CONFIG_NEWLIB_STDIN_LINE_ENDING_CR=y
CONFIG_NEWLIB_NANO_FORMAT=n

#
# Virtual File System
#
CONFIG_VFS_SUPPORT_IO=y
CONFIG_VFS_SUPPORT_DIR=y
CONFIG_VFS_SUPPORT_SELECT=y
CONFIG_VFS_SUPPRESS_SELECT_DEBUG_OUTPUT=y
CONFIG_VFS_SUPPORT_TERMIOS=y

#
# SPI Flash Driver
#
CONFIG_SPI_FLASH_VERIFY_WRITE=n
CONFIG_SPI_FLASH_ENABLE_COUNTERS=n
CONFIG_SPI_FLASH_ROM_DRIVER_PATCH=y
CONFIG_SPI_FLASH_DANGEROUS_WRITE_ABORTS=y
CONFIG_SPI_FLASH_YIELD_DURING_ERASE=y
CONFIG_SPI_FLASH_ERASE_YIELD_DURATION_MS=20
CONFIG_SPI_FLASH_ERASE_YIELD_TICKS=1
CONFIG_SPI_FLASH_WRITE_CHUNK_SIZE=8192

#
# LWIP (Lightweight IP)
#
CONFIG_LWIP_LOCAL_HOSTNAME="esp32_uav"
CONFIG_LWIP_DNS_MAX_SERVERS=3
CONFIG_LWIP_IP_FRAG=y
CONFIG_LWIP_IP_REASSEMBLY=y

#
# Pthread
#
CONFIG_PTHREAD_TASK_PRIO_DEFAULT=5
CONFIG_PTHREAD_TASK_STACK_SIZE_DEFAULT=3072
CONFIG_PTHREAD_STACK_MIN=768

#
# SPI RAM Config (Disabled - using internal RAM only)
#
CONFIG_SPIRAM_SUPPORT=n

# ============================================================================
# CRITICAL SETTINGS FOR HARDWARE PUF - DO NOT MODIFY
# ============================================================================
#
# The following settings are ESSENTIAL for hardware PUF operation:
#
# 1. CONFIG_ESP32_RTC_FAST_MEM_SIZE=8192
#    Allocates 8KB RTC FAST memory for PUF operations
#
# 2. CONFIG_ESP32_ALLOW_RTC_FAST_MEM_AS_HEAP=n
#    Prevents RTC memory from being used as heap (would corrupt PUF data)
#
# 3. CONFIG_BOOTLOADER_SKIP_VALIDATE_IN_DEEP_SLEEP=y
#    Required for deep sleep wake stub to capture uninitialized SRAM
#
# 4. CONFIG_ESP32_DEEP_SLEEP_WAKEUP_DELAY=2000
#    Delay in microseconds before wake stub execution
#
# 5. CONFIG_MBEDTLS_HARDWARE_SHA=y
#    Hardware acceleration for SHA256 (used in authentication)
#
# 6. CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
#    Increased from default 4096 to handle PUF enrollment operations
#
# 7. CONFIG_FREERTOS_CHECK_STACKOVERFLOW_CANARY=y
#    Detects stack overflows during intensive PUF operations
#
# 8. CONFIG_ESP_TASK_WDT_TIMEOUT_S=10
#    Increased timeout to allow for PUF enrollment (can take 5-10 seconds)
#
# ============================================================================

# End of ESP32 Hardware PUF Configuration
